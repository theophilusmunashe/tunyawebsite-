node_modules
dist
.DS_Store

# Local environment configuration — never commit real project ids or tokens
.env
.env.local
.env.*.local

# Sanity Studio
studio/node_modules
studio/dist
studio/.sanity

# Accommodations marketplace runtime data (generated on the server / local Vite API)
public/api/accomodations-data/store.json
public/api/accomodations-data/*.tmp
public/accomodations-media/*
!public/accomodations-media/.gitkeep

# Content engine runtime data
public/api/content-data/store.json
public/api/content-data/*.tmp

# Local booking-request log written by the Vite plugin
public/api/book-requests.json

# Shared workspace runtime data (generated on the server / local Vite API)
public/api/workspace-data/store.json
public/api/workspace-data/*.tmp
