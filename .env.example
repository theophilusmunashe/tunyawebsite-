# Copy to .env and fill in once the Sanity project exists.
# While VITE_SANITY_PROJECT_ID is empty the site renders from the copy bundled
# in src/content/defaults, so it works fine without a CMS connection.

VITE_SANITY_PROJECT_ID=6hxrmwqq
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Admin workspace — https://www.tunyafrika.com/admin
# Change this before the site is public.
VITE_WORKSPACE_KEY=123456

# Quotes and invoices are sent from operations@tunyafrika.com via public/api/send-mail.php
# (cPanel PHP mail). Optional override:
# VITE_MAIL_URL=/api/send-mail.php
# VITE_MAIL_KEY=123456

# Accommodations marketplace uses the same key for workspace writes
# (public/api/accomodations.php). Guests can browse /accomodations without it.

# Optional EmailJS fallback if the PHP endpoint is unavailable
# Template fields: to_email, to_name, from_email, subject, message
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
