# Copy to .env for local development. Everything prefixed VITE_ is PUBLIC:
# it is compiled into the JavaScript every visitor downloads. Never put a
# password, key or token in a VITE_ variable.

# Sanity CMS (public, read-only project id)
VITE_SANITY_PROJECT_ID=6hxrmwqq
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Admin sign-in (/admin) is checked on the server.
#  - Live site: passwords are bcrypt hashes in /home/<cpanel-user>/tunya-config.php
#    (see tunya-config.example.php).
#  - Local dev (`npm run dev`): set TUNYA_DEV_PASSWORD in your shell, or a random
#    password is printed in the terminal when the dev server starts.

# Optional EmailJS fallback if the PHP mail endpoint is unavailable
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
