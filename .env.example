# Copy to .env and fill in once the Sanity project exists.
# While VITE_SANITY_PROJECT_ID is empty the site renders from the copy bundled
# in src/content/defaults, so it works fine without a CMS connection.

VITE_SANITY_PROJECT_ID=6hxrmwqq
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Tunyafrika Workspace — The Basecamp
# Live: https://www.tunyafrika.com/admin
# Local: http://localhost:5173/admin
# Change this phrase before the site is public. It is the shared staff key.
VITE_WORKSPACE_KEY=

# Optional: EmailJS so Dispatch / Ledger send mail from the browser
# Template fields: to_email, to_name, subject, message
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
