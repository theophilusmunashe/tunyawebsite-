{
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)\\.php",
      "headers": [
        {
          "key": "X-Tunya-Api-Note",
          "value": "PHP APIs run on www.tunyafrika.com (cPanel), not on Vercel. The admin client calls the live API from preview hosts."
        },
        {
          "key": "Allow",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    }
  ]
}
